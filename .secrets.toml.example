# Template for .secrets.toml, which is gitignored and never committed.
# Copy this file to .secrets.toml and fill in real values there:
#
#   cp .secrets.toml.example .secrets.toml
#
# Only needed for the [production] (mssql) environment - sqlite/dev needs
# no secrets at all.

[production]
mssql_server = "your-server.database.windows.net"
mssql_database = "your-database"
mssql_user = "your-user"
mssql_password = "your-password"

# Alternative to the four fields above: provide one full connection string
# instead (useful for auth modes other than plain SQL user/password, e.g.
# Azure AD). If set, this takes priority over the fields above.
# mssql_connection_string = "DRIVER={ODBC Driver 18 for SQL Server};SERVER=...;DATABASE=...;UID=...;PWD=...;Encrypt=yes"